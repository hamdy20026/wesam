@echo off
chcp 65001 > nul
title منظومة وسام للأدوات والتوريدات الكهربائية - تشغيل النظام المباشر
color 0A

echo ==============================================================================
echo    منظومة وسام للأدوات والتوريدات الكهربائية
echo    تشغيل البرنامج على الكمبيوتر والربط بقاعدة البيانات (Server DB / SQL Server / XAMPP)
echo ==============================================================================
echo.

:: فحص وجود Node.js
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [خطأ] Node.js غير مثبت على هذا الجهاز!
    echo يرجى تحميل وتثبيت Node.js من: https://nodejs.org
    pause
    exit /b
)

echo [1/3] جاري فحص ملفات البرنامج وقاعدة البيانات...
if not exist node_modules (
    echo [2/3] جاري تثبيت الحزم والمكتبات لأول مرة...
    call npm install
) else (
    echo [2/3] الحزم مثبتة بالفعل.
)

echo [3/3] جاري تشغيل سيرفر المنظومة المباشر على المنفذ 3000...
start "" http://localhost:3000

:: تشغيل السيرفر
call npm start

pause
